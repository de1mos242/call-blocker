<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CallBlocker" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1D6B52</item>
        <item name="android:navigationBarColor">#F7F5EF</item>
        <item name="android:statusBarColor">#F7F5EF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F5EF</item>
    </style>

    <style name="TextAppearance.CallBlocker.Title" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">#18332B</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CallBlocker.Heading" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textColor">#18332B</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CallBlocker.Status" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#18332B</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CallBlocker.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#4B5B56</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.CallBlocker.Number" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">#18332B</item>
        <item name="android:fontFamily">sans-mono</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
